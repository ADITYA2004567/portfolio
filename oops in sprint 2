class TestCase:
    def __init__(self, test_case_id, functionality, role, test_steps, expected_result, actual_result, cycle_1):
        self.test_case_id = test_case_id
        self.functionality = functionality
        self.role = role
        self.test_steps = test_steps
        self.expected_result = expected_result
        self.actual_result = actual_result
        self.cycle_1 = cycle_1

    def is_test_passed(self):
        return self.expected_result == self.actual_result

    def display_summary(self):
        status = " Passed" if self.is_test_passed() else "Failed"
        print(f"Test Case ID: {self.test_case_id} | Functionality: {self.functionality} | Status: {status}")

class FunctionalTestCase(TestCase):
    def __init__(self, *args, priority='Medium', **kwargs):
        super().__init__(*args, **kwargs)
        self.priority = priority

    def display_details(self):3
        print(f" Functional Test | Priority: {self.priority}")
        self.display_summary()
